# Application
APP_NAME=Async Task Queue
APP_VERSION=1.0.0
APP_DEBUG=false

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_SOCKET_TIMEOUT=5.0
REDIS_SOCKET_CONNECT_TIMEOUT=5.0

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VIRTUAL_HOST=/
RABBITMQ_HEARTBEAT=60
RABBITMQ_CONNECTION_TIMEOUT=10.0

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=taskqueue
POSTGRES_PASSWORD=taskqueue
POSTGRES_DB=taskqueue
POSTGRES_POOL_SIZE=5
POSTGRES_MAX_OVERFLOW=10
POSTGRES_POOL_TIMEOUT=30.0
POSTGRES_POOL_RECYCLE=3600

# Task settings
TASK_MAX_RETRIES=3
TASK_RETRY_DELAY=1.0
TASK_TIMEOUT=60.0
TASK_DEFAULT_TTL=3600
TASK_RATE_LIMIT=100
TASK_RATE_LIMIT_WINDOW=60
TASK_DEAD_LETTER_QUEUE=tasks.dlq
